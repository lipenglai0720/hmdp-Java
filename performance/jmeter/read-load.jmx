<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="HMDP - mixed read load" enabled="true">
      <stringProp name="TestPlan.comments">Dedicated test data only. HTTP 200 alone is not a business success.</stringProp>
